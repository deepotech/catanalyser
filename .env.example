# ==============================================================================
# SERVER-SIDE AI PROVIDER CONFIGURATION (NEVER EXPOSED TO THE BROWSER)
# ==============================================================================
# Choose the AI provider:
# - 'openrouter' : OpenRouter API (supports Gemini 2.5, Claude 3.5, GPT-4o, Llama 3.2 Vision)
# - 'gemini'     : Direct Google Gemini API (requires GEMINI_API_KEY)
# - 'mock'       : Offline Development Mock Provider (zero external API calls)
AI_PROVIDER=openrouter

# OpenRouter Configuration (used when AI_PROVIDER=openrouter)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Google Gemini API Configuration (used when AI_PROVIDER=gemini)
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# APPLICATION URLS & SETTINGS
# ==============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

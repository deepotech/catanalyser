# ==============================================================================
# CatAnalyzer.com — Environment Variables Specification
# ==============================================================================

# Runtime Environment ('development' | 'test' | 'production')
NODE_ENV=development

# AI Provider Selection ('openrouter' | 'gemini' | 'mock')
# Production requires 'openrouter' or 'gemini'. 'mock' is allowed only for local development/testing.
AI_PROVIDER=openrouter

# OpenRouter Configuration (required if AI_PROVIDER=openrouter)
# Obtains multimodal vision & audio inference via models like google/gemini-2.5-flash
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Google Gemini API Configuration (required if AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Distributed Rate Limiting via Upstash Redis REST
# When provided, activates multi-instance distributed rate limiting.
# When omitted, falls back to in-memory sliding window (single-instance only).
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# Production Error Monitoring (Optional)
SENTRY_DSN=

# Public Canonical Site URL (safe to expose to browser)
NEXT_PUBLIC_SITE_URL=https://catanalyzer.com

# Request Limits and Cost Protection
AI_MAX_IMAGE_MB=10
AI_MAX_AUDIO_MB=10
AI_MAX_AUDIO_SECONDS=15
AI_REQUEST_TIMEOUT_MS=20000
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
